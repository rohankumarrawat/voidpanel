# ── Server Config ──────────────────────────────
PORT=4100
NODE_ENV=development

# ── MongoDB ────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/voidtools_db

# ── CORS ───────────────────────────────────────
CORS_ORIGIN=https://tools.voidonyx.in

# ── DNS Checker Config ─────────────────────────
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
IP_SALT=voidtools-dns-salt-change-me
