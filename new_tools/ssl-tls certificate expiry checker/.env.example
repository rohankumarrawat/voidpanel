# ==========================================
# VoidOnyX SSL/TLS Checker Environment Configuration
# ==========================================

# Backend API Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local Docker)
MONGODB_URI=mongodb://localhost:27017/ssl_checker

# Cache TTL Configuration (in seconds, default 10 minutes)
CACHE_TTL_SECONDS=600

# Rate Limiting Configuration (10 requests per 60 seconds per IP hash)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# TLS Handshake Timeout (in milliseconds, default 8000ms = 8s)
TLS_TIMEOUT_MS=8000

# Frontend API URL (leave empty for relative /api proxy in Vite dev server)
VITE_API_URL=
