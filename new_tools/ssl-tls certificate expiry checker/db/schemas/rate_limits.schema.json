{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RateLimits",
  "type": "object",
  "properties": {
    "ipHash": { "type": "string" },
    "count": { "type": "integer" },
    "windowStart": { "type": "string", "format": "date-time" },
