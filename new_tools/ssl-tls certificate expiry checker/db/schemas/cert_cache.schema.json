{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CertCache",
  "type": "object",
  "properties": {
    "hostPort": { "type": "string" },
    "host": { "type": "string" },
    "port": { "type": "integer" },
    "result": { "type": "object" },
    "cachedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "required": ["hostPort", "host", "port", "result", "expiresAt"]
}
