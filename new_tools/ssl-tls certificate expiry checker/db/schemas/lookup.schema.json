{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lookup",
  "type": "object",
  "properties": {
    "host": { "type": "string" },
    "port": { "type": "integer", "default": 443 },
    "status": { "type": "string", "enum": ["valid", "expiring", "expired", "untrusted", "error"] },
    "daysRemaining": { "type": ["integer", "null"] },
    "issuer": {
      "type": "object",
      "properties": {
        "cn": { "type": "string" },
        "o": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "properties": {
        "cn": { "type": "string" },
        "o": { "type": "string" }
      }
    },
    "sans": { "type": "array", "items": { "type": "string" } },
    "notBefore": { "type": "string", "format": "date-time" },
    "notAfter": { "type": "string", "format": "date-time" },
    "fingerprintSha256": { "type": "string" },
    "tlsVersionsSupported": { "type": "array", "items": { "type": "string" } },
    "checkedAt": { "type": "string", "format": "date-time" },
    "requesterIpHash": { "type": "string" }
  },
  "required": ["host", "port", "status", "requesterIpHash"]
}
