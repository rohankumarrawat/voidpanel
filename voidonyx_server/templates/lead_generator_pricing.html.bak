{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} | VoidPanel</title>
    <meta name="description" content="{{ tagline }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/static/fav.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/assets/css/void-modern.css">
    <style>
        :root {
            --lg-c:   #10b981;
            --lg-c2:  #0ea5e9;
            --lg-glow:  rgba(16,185,129,0.35);
            --lg-glow2: rgba(14,165,233,0.25);
        }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; margin: 0; }

        /* ── Hero ── */
        .lg-hero {
            padding: 130px 20px 0;
            text-align: center;
            background:
                radial-gradient(ellipse at 15% 10%, var(--lg-glow), transparent 55%),
                radial-gradient(ellipse at 85% 80%, var(--lg-glow2), transparent 50%),
                radial-gradient(ellipse at 55% 0%, rgba(16,185,129,0.1), transparent 45%),
                linear-gradient(160deg, #0f172a 0%, #1e293b 60%, #064e3b 100%);
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .lg-hero::before {
            content: '';
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.018'%3E%3Ccircle cx='30' cy='30' r='1'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
        }
        .lg-hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.3);
            border-radius: 999px; padding: 6px 18px; font-size: .82rem; font-weight: 600;
            color: rgba(255,255,255,.85); margin-bottom: 24px; backdrop-filter: blur(8px);
        }
        .lg-hero-badge i { color: var(--lg-c); }
        .lg-hero h1 {
            color: #fff;
            font-size: clamp(2.4rem, 5.5vw, 4rem);
            font-weight: 900;
            margin: 0 0 6px;
            letter-spacing: -.025em;
            line-height: 1.1;
        }
        .lg-hero h1 .grad {
            background: linear-gradient(120deg, #34d399, #22d3ee, #10b981);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .lg-hero p {
            font-size: 1.12rem;
            color: rgba(255,255,255,.58);
            max-width: 600px;
            margin: 16px auto 0;
            line-height: 1.75;
        }

        /* ── Stats strip ── */
        .lg-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
            padding: 40px 20px;
            max-width: 800px;
            margin: 0 auto;
        }
        .lg-stat { text-align: center; }
        .lg-stat strong {
            display: block;
            font-size: 1.8rem;
            font-weight: 900;
            color: #fff;
            letter-spacing: -.02em;
        }
        .lg-stat span { font-size: .82rem; color: rgba(255,255,255,.45); font-weight: 500; }

        /* ── Scroll wave ── */
        .lg-wave {
            display: block;
            width: 100%;
            height: 70px;
            margin-bottom: -2px;
        }

        /* ── Plans section ── */
        .lg-plans-section {
            background: #f5f7fa;
            padding: 0 20px 80px;
        }
        .lg-plans-inner { max-width: 1160px; margin: 0 auto; }
        .lg-section-top {
            text-align: center;
            padding: 50px 20px 40px;
        }
        .lg-section-top h2 {
            font-size: 1.9rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 10px;
            letter-spacing: -.02em;
        }
        .lg-section-top p { color: #64748b; margin: 0; font-size: .95rem; }

        .lg-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            gap: 24px;
            align-items: start;
        }

        .lg-card {
            background: #fff;
            border: 1.5px solid #e2e8f0;
            border-radius: 22px;
            padding: 34px 28px 28px;
            position: relative;
            transition: all .28s cubic-bezier(.4,0,.2,1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .lg-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--lg-c), var(--lg-c2));
            opacity: 0;
            transition: opacity .3s;
        }
        .lg-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 24px 60px rgba(0,0,0,.09);
            border-color: var(--lg-c);
        }
        .lg-card:hover::before { opacity: 1; }
        .lg-card.featured {
            border-color: var(--lg-c);
            box-shadow: 0 0 0 3px rgba(16,185,129,.15), 0 20px 50px rgba(0,0,0,.1);
            transform: translateY(-4px) scale(1.015);
        }
        .lg-card.featured::before { opacity: 1; }
        .lg-card.featured:hover { transform: translateY(-10px) scale(1.015); }

        .lg-badge-wrap {
            position: absolute;
            top: -1px; left: 50%;
            transform: translateX(-50%);
        }
        .lg-pop-badge {
            display: inline-flex; align-items: center; gap: 5px;
            background: linear-gradient(135deg, var(--lg-c), var(--lg-c2));
            color: #fff;
            border-radius: 0 0 10px 10px;
            padding: 5px 18px;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            white-space: nowrap;
            box-shadow: 0 4px 14px var(--lg-glow);
        }
        .lg-plan-icon {
            width: 44px; height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(16,185,129,.12), rgba(14,165,233,.08));
            border: 1px solid rgba(16,185,129,.2);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 16px;
            font-size: 1.1rem;
            color: var(--lg-c);
        }
        .lg-plan-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
        }
        .lg-plan-desc {
            font-size: .85rem;
            color: #64748b;
            line-height: 1.55;
            margin-bottom: 22px;
            min-height: 44px;
        }
        .lg-price {
            font-size: 2.8rem;
            font-weight: 900;
            color: #0f172a;
            letter-spacing: -.03em;
            margin-bottom: 6px;
            line-height: 1;
        }
        .lg-price sup { font-size: 1.3rem; vertical-align: super; }
        .lg-price-note { font-size: .82rem; color: #94a3b8; margin-bottom: 24px; }

        .lg-divider {
            border: none;
            border-top: 1px solid #f1f5f9;
            margin: 0 0 20px;
        }

        .lg-feature-list {
            list-style: none;
            padding: 0;
            margin: 0 0 28px;
            flex: 1;
        }
        .lg-feature-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: .875rem;
            color: #374151;
            padding: 7px 0;
            border-bottom: 1px solid #f8fafc;
        }
        .lg-feature-list li:last-child { border-bottom: none; }
        .lg-feature-list li .fi {
            width: 20px; height: 20px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .68rem;
            flex-shrink: 0;
        }
        .fi-yes { background: rgba(16,185,129,.12); color: #10b981; }
        .fi-no  { background: rgba(148,163,184,.1); color: #94a3b8; }

        .lg-btn {
            display: block;
            width: 100%;
            padding: 14px 20px;
            border-radius: 12px;
            font-size: .93rem;
            font-weight: 700;
            text-align: center;
            text-decoration: none;
            transition: all .2s;
            cursor: pointer;
            border: none;
            font-family: inherit;
            letter-spacing: .01em;
        }
        .lg-btn-primary {
            background: linear-gradient(135deg, var(--lg-c), var(--lg-c2));
            color: #fff;
            box-shadow: 0 4px 20px var(--lg-glow);
        }
        .lg-btn-primary:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
            box-shadow: 0 8px 28px var(--lg-glow);
        }
        .lg-btn-outline {
            background: transparent;
            color: var(--lg-c);
            border: 1.5px solid rgba(16,185,129,.35);
        }
        .lg-btn-outline:hover {
            background: rgba(16,185,129,.07);
            border-color: var(--lg-c);
        }

        /* ── Platform Features ── */
        .lg-feat-section {
            padding: 80px 20px;
            background: linear-gradient(160deg, #0f172a 0%, #1c1917 60%, #064e3b 100%);
            position: relative;
        }
        .lg-feat-section::before {
            content: '';
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.018'%3E%3Ccircle cx='30' cy='30' r='1'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }
        .lg-feat-inner { max-width: 1080px; margin: 0 auto; position: relative; z-index: 1; }
        .lg-feat-hd {
            text-align: center;
            margin-bottom: 56px;
        }
        .lg-feat-hd h2 {
            font-size: 2.1rem; font-weight: 800; color: #fff;
            margin: 0 0 12px; letter-spacing: -.025em;
        }
        .lg-feat-hd p { color: rgba(255,255,255,.5); font-size:.95rem; margin:0; }
        .lg-feat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 18px;
        }
        .lg-feat-card {
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 18px;
            padding: 26px 22px;
            transition: all .25s;
        }
        .lg-feat-card:hover {
            background: rgba(16,185,129,.08);
            border-color: rgba(16,185,129,.35);
            transform: translateY(-3px);
        }
        .lg-feat-card .fci {
            width: 46px; height: 46px;
            border-radius: 13px;
            background: linear-gradient(135deg, rgba(16,185,129,.2), rgba(14,165,233,.15));
            border: 1px solid rgba(16,185,129,.25);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
            color: #34d399;
            margin-bottom: 16px;
        }
        .lg-feat-card h3 {
            font-size: .98rem; font-weight: 700; color: #fff;
            margin: 0 0 8px; letter-spacing: -.01em;
        }
        .lg-feat-card p { font-size: .82rem; color: rgba(255,255,255,.45); margin: 0; line-height: 1.6; }

        /* ── CTA strip ── */
        .lg-cta {
            text-align: center;
            padding: 70px 20px 80px;
            background: #f5f7fa;
        }
        .lg-cta h2 { font-size: 1.8rem; font-weight: 800; color: #0f172a; margin: 0 0 12px; }
        .lg-cta p { color: #64748b; margin: 0 0 28px; font-size:.95rem; }
        .lg-cta a {
            display: inline-flex; align-items: center; gap: 8px;
            background: linear-gradient(135deg, var(--lg-c), var(--lg-c2));
            color: #fff; padding: 14px 32px;
            border-radius: 12px; font-weight: 700; font-size:.95rem;
            text-decoration: none;
            box-shadow: 0 6px 24px var(--lg-glow);
            transition: all .2s;
        }
        .lg-cta a:hover { filter: brightness(1.1); transform: translateY(-2px); }

        @media (max-width: 640px) {
            .lg-hero { padding: 110px 16px 0; }
            .lg-stats { gap: 24px; }
            .lg-grid { grid-template-columns: 1fr; }
            .lg-card.featured { transform: none; }
        }
    </style>
</head>
<body>

{% include "voidonyx/header.html" %}

<!-- ══ HERO ══ -->
<div class="lg-hero">
    <div class="lg-hero-badge">
        <i class="fa-solid fa-crosshairs"></i>
        AI Lead Prospecting Platform
    </div>
    <h1>Find &amp; Close Your<br><span class="grad">Ideal Customers</span></h1>
    <p>AI-powered B2B lead prospecting — discover decision-makers, enrich contacts, analyze tech stacks, and manage deals all in one platform.</p>

    <div class="lg-stats">
        <div class="lg-stat">
            <strong>50K+</strong>
            <span>Leads Generated</span>
        </div>
        <div class="lg-stat">
            <strong>99.9%</strong>
            <span>Uptime SLA</span>
        </div>
        <div class="lg-stat">
            <strong>24/7</strong>
            <span>Platform Access</span>
        </div>
        <div class="lg-stat">
            <strong>2 min</strong>
            <span>Setup Time</span>
        </div>
    </div>

    <svg class="lg-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,70 L0,70 Z" fill="#f5f7fa"/>
    </svg>
</div>

<!-- ══ PLANS ══ -->
<section class="lg-plans-section">
    <div class="lg-plans-inner">
        <div class="lg-section-top">
            <h2>Simple, Transparent Pricing</h2>
            <p>Choose the plan that fits your prospecting needs and start generating leads instantly.</p>
        </div>

        <div class="lg-grid">
            {% for pkg in packages %}
            <div class="lg-card {% if forloop.counter == 2 %}featured{% endif %}">

                {% if forloop.counter == 2 %}
                <div class="lg-badge-wrap">
                    <span class="lg-pop-badge"><i class="fa-solid fa-fire-flame-curved"></i> Most Popular</span>
                </div>
                {% endif %}

                <div class="lg-plan-icon">
                    {% if forloop.counter == 1 %}
                        <i class="fa-solid fa-seedling"></i>
                    {% elif forloop.counter == 2 %}
                        <i class="fa-solid fa-rocket"></i>
                    {% else %}
                        <i class="fa-solid fa-crown"></i>
                    {% endif %}
                </div>

                <div class="lg-plan-name">{{ pkg.name }}</div>
                <div class="lg-plan-desc">{{ pkg.description }}</div>

                <div class="lg-price">
                    {% if pkg.price == 0 or pkg.price == 0.0 or pkg.price == "0.00" %}
                    Free
                    {% else %}
                    <sup>₹</sup>{{ pkg.price }}
                    {% endif %}
                </div>
                <div class="lg-price-note">
                    {% if pkg.price == 0 or pkg.price == 0.0 or pkg.price == "0.00" %}
                    No credit card required
                    {% else %}
                    per month &nbsp;·&nbsp; billed monthly
                    {% endif %}
                </div>

                <hr class="lg-divider">

                <ul class="lg-feature-list">
                    {% for feature in pkg.features %}
                    <li>
                        <span class="fi fi-yes"><i class="fa-solid fa-check"></i></span>
                        {{ feature }}
                    </li>
                    {% endfor %}
                </ul>

                <a href="/lead-generator/configure/{{ pkg.id }}/" class="lg-btn {% if forloop.counter == 2 %}lg-btn-primary{% else %}lg-btn-outline{% endif %}">
                    Get Started &nbsp;<i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
            {% empty %}
            <div style="grid-column: 1/-1; text-align:center; padding: 60px 20px; color: #94a3b8;">
                <i class="fa-solid fa-spinner fa-spin" style="font-size:2rem; display:block; margin-bottom:16px;"></i>
                Loading plans… Please refresh in a moment.
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ══ PLATFORM FEATURES ══ -->
<section class="lg-feat-section">
    <div class="lg-feat-inner">
        <div class="lg-feat-hd">
            <h2>Everything Your Sales Team Needs</h2>
            <p>Purpose-built tools to find prospects, enrich contacts, and close deals faster.</p>
        </div>
        <div class="lg-feat-grid">
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                <h3>Website Intelligence</h3>
                <p>Automatically detect tech stacks, CMS platforms, and hosting details from any website URL.</p>
            </div>
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-address-book"></i></div>
                <h3>Contact Enrichment</h3>
                <p>AI-powered contact discovery — find emails, phone numbers, and social profiles of decision-makers.</p>
            </div>
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-chart-pie"></i></div>
                <h3>CRM Deal Pipeline</h3>
                <p>Visual Kanban pipeline to track deals from lead to close — with notes, tags, and reminders.</p>
            </div>
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-file-csv"></i></div>
                <h3>Bulk Import &amp; Export</h3>
                <p>Import websites in bulk via CSV. Export enriched lead data to Excel or integrate via API.</p>
            </div>
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-users-gear"></i></div>
                <h3>Team Collaboration</h3>
                <p>Invite team members, assign leads, and collaborate on deals with role-based access control.</p>
            </div>
            <div class="lg-feat-card">
                <div class="fci"><i class="fa-solid fa-bolt"></i></div>
                <h3>REST API Access</h3>
                <p>Integrate lead data into your CRM, marketing tools, or custom workflows with our developer API.</p>
            </div>
        </div>
    </div>
</section>

<!-- ══ CTA ══ -->
<section class="lg-cta">
    <h2>Ready to Supercharge Your Sales?</h2>
    <p>Pick a plan above and your workspace will be live in under 2 minutes.</p>
    <a href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">
        <i class="fa-solid fa-rocket"></i> Choose a Plan
    </a>
</section>

{% include "voidonyx/footer.html" %}

</body>
</html>
